# ==============================================================================
# STUDENTBRAIN ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env before starting containers or local servers:
# Linux/macOS: `cp .env.example .env`
# Windows:     `copy .env.example .env`
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
POSTGRES_DB=student_brain
POSTGRES_USER=student_brain
POSTGRES_PASSWORD=your_secure_postgres_password_here
# Use 'db' when running with Docker Compose, 'localhost' when running standalone
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Google Gemini AI Service API Key
# (Get your free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth / Institutional SSO Configuration (Optional)
# (Get credentials from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

# Database Seeding on Container Boot (true/false)
AUTO_SEED=true
