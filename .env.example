# ==============================================================================
# STUDENTBRAIN ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Core Django Settings ---
DJANGO_SECRET_KEY=dev-secret-key-studentbrain-insecure-replace-in-prod
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# --- Database Configuration ---
# OPTION 1: TiDB Cloud / Remote Cloud Database (Recommended for Render)
# Format for TiDB (MySQL compatible):
# DATABASE_URL=mysql://<USERNAME>:<PASSWORD>@<HOST>:4000/<DATABASE>?ssl_mode=VERIFY_IDENTITY
# Format for PostgreSQL (Render/Supabase/Neon):
# DATABASE_URL=postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=

# OPTION 2: Local PostgreSQL (Used if DATABASE_URL is empty)
POSTGRES_DB=student_brain
POSTGRES_USER=student_brain
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Force SQLite locally if PostgreSQL is not running (true/false)
USE_SQLITE=False

# --- Google Gemini AI Service API Key ---
# (Get yours free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# --- CORS & Frontend Configuration ---
CORS_ALLOW_ALL_ORIGINS=True
VITE_API_URL=http://localhost:8000/api
